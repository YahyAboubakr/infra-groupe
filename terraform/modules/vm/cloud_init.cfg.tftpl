#cloud-config
hostname: ${hostname}
fqdn: ${hostname}.${domain}
manage_etc_hosts: true

keyboard:
  layout: fr
  model: pc105

users:
  - name: ${username}
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    lock_passwd: false
    plain_text_passwd: ${password}
%{ if ssh_key != "" ~}
    ssh_authorized_keys:
      - ${ssh_key}
%{ endif ~}

ssh_pwauth: false
chpasswd:
  expire: false

# Agent invité Xen (xe-guest-utilities) requis pour remonter les IP et métriques à Xen Orchestra.
# Le reste des services est installé par Ansible.
package_update: true
packages:
  - xe-guest-utilities
  - python3
  - sudo
  - curl
  - keyboard-configuration
  - console-setup

runcmd:
  - systemctl enable --now xe-linux-distribution
  - localectl set-x11-keymap fr pc105
  - setupcon -k --force || systemctl restart keyboard-setup console-setup
